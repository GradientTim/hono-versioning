{
  "name": "@gradienttim/hono-versioning",
  "version": "0.1.2",
  "description": "Type-safe API versioning for Hono - URI, header, and query strategies",
  "keywords": [
    "api",
    "api-versioning",
    "bun",
    "cloudflare-workers",
    "deno",
    "edge",
    "header-versioning",
    "hono",
    "hono-middleware",
    "hono-plugin",
    "middleware",
    "nodejs",
    "query-versioning",
    "rest-api",
    "router",
    "routing",
    "type-safe",
    "typescript",
    "uri-versioning",
    "url-versioning",
    "version",
    "versioning",
    "x-api-version"
  ],
  "homepage": "https://docs.gradienttim.dev/hono-versioning",
  "bugs": {
    "url": "https://github.com/GradientTim/hono-versioning/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Tim Kiesel",
    "email": "social@gradienttim.dev",
    "url": "https://github.com/GradientTim"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GradientTim/hono-versioning.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "bun run type-check && bun test && bun run build",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "type-check": "tsc --noEmit",
    "bench": "bun run bench/index.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/bun": "^1.4.5",
    "mitata": "^1.0.34",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "hono": "^4.13.19"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.6"
}
